<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="user/css/login_style.css">
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/izitoast/dist/css/iziToast.min.css">
    <script src="https://cdn.jsdelivr.net/npm/izitoast/dist/js/iziToast.min.js" defer></script>
         
    <script src="user/js/login.js" defer></script>

    <title>Gadgetory | Sign Un</title>
    <link rel="icon" href="assets/icons/gadgetory-favicon.png" type="image/x-icon">
</head>
<body>
    <section class="bg-light min-vh-100 d-flex align-items-center py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card border-0 shadow-lg overflow-hidden">
                        <div class="row g-0">

                            <div class="login_bg_img col-12 col-md-6 d-none d-md-block login-image-container rounded-start ">
                                </div>
                            
                            <div class="col-12 col-md-6 d-flex justify-content-center align-items-center p-4 p-lg-5">
                                <div class="w-100">
                                    
                                    <h1 class="text-center mb-4">Log In</h1>
                                    
                                    <form action="/login" method="post" id="loginForm" onsubmit="submit_form(event)">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="form-floating">
                                                    <input type="email" class="form-control" name="email" id="email" placeholder="name@example.com" required>
                                                    <label for="email">Email address</label>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-floating">
                                                    <input type="password" class="form-control" name="password" id="password" placeholder="Password" required>
                                                    <label for="password">Password</label>
                                                    
                                                </div>
                                            </div>
                                            <div class="col-12 text-end">
                                                <a href="/forgot_password" class="text-decoration-none text-muted small">Forgot password?</a>
                                            </div>
                                            <div class="col-12">
                                                <div class="d-grid pt-2">
                                                    <button class="btn btn-dark btn-lg login-button" type="submit" aria-label="Log in">Log in now</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>

                                    <hr class="my-4">

                                    <div class="text-center mb-3">
                                        <p class="text-muted small mb-3">Or continue with</p>
                                        <div class="d-flex justify-content-center social-login-buttons">
                                            <a href="/auth/google" class="btn btn-outline-secondary social-icon-btn d-flex align-items-center justify-content-center" aria-label="Sign in with Google">
                                                <img src="assets/icons/google_logo.png" alt="Google Logo" class="social-icon">
                                            </a>
                                            </div>
                                    </div>

                                    <p class="text-center mt-4 mb-0 text-muted">
                                        Don't have an account? <a href="/signup" class="text-decoration-none fw-bold">Sign&nbsp;up</a>
                                    </p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>